// Premultiplied output: a ring with soft edges over transparency (SkSL has
// no discard; outside the ring returns transparent black).
uniform float3 iResolution;

half4 main(float2 coord) {
    float2 p = (2.0 * coord - iResolution.xy) / iResolution.y;
    float r = length(p);
    if (r > 0.9 || r < 0.4) {
        return half4(0.0);
    }
    half a = half(smoothstep(0.9, 0.8, r) * smoothstep(0.4, 0.5, r));
    return half4(half3(r, 1.0 - r, 0.5) * a, a);
}
